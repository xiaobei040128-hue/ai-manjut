NODE_ENV=production
PORT=4173
DRAMA_DATA_DIR=./runtime-data
# Public HTTPS hostname(s), comma separated, without scheme or port.
DRAMA_ALLOWED_HOSTS=
# Set to 1 behind an HTTPS reverse proxy before allowing public hosts.
DRAMA_COOKIE_SECURE=0
# Set a strong random value for the initial administrator setup; do not commit it.
DRAMA_SETUP_TOKEN=
DRAMA_TRUST_PROXY=0
DRAMA_TRUST_PROXY_ADDRESSES=127.0.0.1,::1
